# Copy these names into your shell before starting the API.
# This file is an example only. The API does not read it.
# Use a random JWT_SECRET of at least 32 characters.
# Do not commit a real .env file.

DB_USERNAME=replace-with-your-mysql-username
DB_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
ADMIN_PASSWORD=replace-with-an-admin-password
